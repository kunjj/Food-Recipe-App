<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="recipesViewModel"
            type="com.example.foodrecipesapplication.viewmodels.FoodRecipesViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivUserProfile"
            loadImageFromUri="@{recipesViewModel.currentUser.photoUrl}"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="5dp"
            android:layout_marginTop="30dp"
            app:shapeAppearance="@style/ProfileImageShape"
            app:strokeColor="@color/strokeColor"
            app:strokeWidth="1.25dp"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/tvUserProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5dp"
            android:layout_marginVertical="10dp"
            android:text="@{recipesViewModel.currentUser.displayName}"
            android:textSize="28sp"
            tools:text="@string/test_user"
            android:fontFamily="@font/arbutus_slab"
            android:gravity="center"
            android:textColor="@color/green"/>
    </LinearLayout>
</layout>